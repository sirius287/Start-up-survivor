PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/startup_survivor
JWT_SECRET=replace-with-a-long-random-value
NODE_ENV=development

# Admin / Game Master — one shared passphrase, one control room.
#   node -e "require('bcrypt').hash('your-passphrase',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Judges live entirely here. Add a NAME/CODE pair per judge, numbered from 1.
# However many pairs exist, that many judges exist — no signup, no admin form.
JUDGE_1_NAME=Judge One
JUDGE_1_CODE=JUDGE1
JUDGE_2_NAME=Judge Two
JUDGE_2_CODE=JUDGE2
JUDGE_3_NAME=Judge Three
JUDGE_3_CODE=JUDGE3

# Auth requests per minute per IP. Default 300 because at a venue every team is
# behind ONE WiFi NAT and shares a public IP — a low limit locks out everyone
# after the first few registrations.
# AUTH_RATE_LIMIT=300

# Teams at/above this count switch judging from "everyone scores everyone" to
# an even split between judges.
# JUDGE_PARTITION_THRESHOLD=20

# TEST ONLY. Fakes Google Docs snapshots so the e2e suite and the 40-team
# simulation can run without real shared documents. Never set in production.
# MOCK_DOC_SNAPSHOTS=1
